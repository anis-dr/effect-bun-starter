{
  "name": "@effect-bun-starter/database",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --build",
    "db:check": "bun --env-file=../../.env drizzle-kit check",
    "db:export": "bun --env-file=../../.env drizzle-kit export",
    "db:generate": "bun --env-file=../../.env drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env drizzle-kit migrate",
    "db:pull": "bun --env-file=../../.env drizzle-kit pull",
    "db:push": "bun --env-file=../../.env drizzle-kit push",
    "db:studio": "bun --env-file=../../.env drizzle-kit studio",
    "db:up": "bun --env-file=../../.env drizzle-kit up",
    "test": "bun --env-file=../../.env vitest run",
    "typecheck": "tsc --build && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@effect/sql-pg": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect-bun-starter/typescript-config": "workspace:*",
    "@effect/vitest": "catalog:",
    "@types/bun": "catalog:",
    "drizzle-kit": "catalog:",
    "vitest": "catalog:"
  }
}
