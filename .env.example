DATABASE_URL=postgres://postgres:postgres@localhost:5437/effect_bun_starter
BETTER_AUTH_SECRET=replace-with-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3002
BETTER_AUTH_TRUSTED_ORIGIN=http://localhost:3000
# The one account, by email, that appoints and removes admins. Unset: no superadmin.
# SUPERADMIN_EMAIL=owner@example.com
VITE_API_URL=http://localhost:3002
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:27686
OTEL_DEPLOYMENT_ENVIRONMENT=development
OTEL_SERVICE_VERSION=0.0.0
VITE_OTEL_EXPORTER_OTLP_TRACES_URL=/api/otel/v1/traces
VITE_OTEL_DEPLOYMENT_ENVIRONMENT=development
VITE_OTEL_SERVICE_VERSION=0.0.0
# Email: MAIL_TRANSPORT=smtp sends through SMTP_URL (Mailpit from `bun run mail:up`,
# inbox at http://localhost:8025); production uses MAIL_TRANSPORT=resend with
# RESEND_API_KEY and an EMAIL_FROM on a domain verified in Resend.
MAIL_TRANSPORT=smtp
SMTP_URL=smtp://localhost:1025
# RESEND_API_KEY=re_...
EMAIL_FROM=App <no-reply@example.com>
# The product name emails show.
APP_NAME=App
