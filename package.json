{
  "name": "effect-bun-starter",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@effect/opentelemetry": "^4.0.0-beta.97",
      "@effect/platform-bun": "^4.0.0-beta.97",
      "@effect/sql-pg": "^4.0.0-beta.97",
      "@effect/vitest": "^4.0.0-beta.97",
      "@types/bun": "^1.3.14",
      "drizzle-kit": "1.0.0-rc.3",
      "drizzle-orm": "1.0.0-rc.3",
      "effect": "^4.0.0-beta.97",
      "typescript": "^7.0.2",
      "vitest": "^4.1.10"
    }
  },
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "db:up": "docker compose up -d --wait database",
    "dev": "turbo dev",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "lint": "ultracite check .",
    "lint:fix": "ultracite fix .",
    "prepare": "effect-tsgo patch",
    "test": "turbo test",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@effect/tsgo": "^0.19.0",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "turbo": "^2.10.4",
    "typescript": "catalog:",
    "ultracite": "^7.9.3"
  },
  "packageManager": "bun@1.3.14"
}
