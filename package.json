{
  "name": "effect-bun-starter",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@effect/opentelemetry": "^4.0.0-rc.117",
      "@effect/platform-bun": "^4.0.0-rc.117",
      "@effect/sql-pg": "^4.0.0-rc.117",
      "@effect/vitest": "^4.0.0-rc.117",
      "@types/bun": "^1.3.14",
      "drizzle-kit": "1.0.0-rc.5-5935859",
      "drizzle-orm": "1.0.0-rc.5-5935859",
      "effect": "^4.0.0-rc.117",
      "typescript": "^7.0.2",
      "vitest": "^5.0.2"
    }
  },
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "astryx": "bun run --cwd apps/web astryx",
    "db:up": "docker compose up -d --wait database",
    "dev": "turbo dev",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "lint": "ultracite check .",
    "lint:fix": "ultracite fix .",
    "prepare": "effect-tsgo patch",
    "test": "turbo test",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.1.8",
    "@effect/tsgo": "0.46.1",
    "@oxlint/plugins": "1.80.0",
    "@shekohex/oxc-effect": "0.2.1",
    "oxfmt": "^0.58.0",
    "oxlint": "1.80.0",
    "oxlint-plugin-effect": "0.11.0",
    "turbo": "^2.10.4",
    "typescript": "catalog:",
    "ultracite": "^7.9.3"
  },
  "packageManager": "bun@1.3.14"
}
