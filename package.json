{
  "name": "effect-bun-starter",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@effect/opentelemetry": "^4.0.0-rc.117",
      "@effect/platform-bun": "^4.0.0-rc.117",
      "@effect/sql-pg": "^4.0.0-rc.117",
      "@effect/vitest": "^4.0.0-rc.117",
      "@types/bun": "^1.4.2",
      "drizzle-kit": "1.0.0-rc.5-5935859",
      "drizzle-orm": "1.0.0-rc.5-5935859",
      "effect": "^4.0.0-rc.117",
      "typescript": "^7.0.2",
      "vitest": "^5.0.2"
    }
  },
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "astryx": "bun run --cwd apps/web astryx",
    "db:up": "docker compose up -d --wait database",
    "mail:up": "docker compose up -d mail",
    "email:dev": "bun run --cwd packages/email dev",
    "dev": "turbo dev",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "lint": "ultracite check --type-aware .",
    "lint:fix": "ultracite fix --type-aware .",
    "prepare": "effect-tsgo patch && git config core.hooksPath .githooks",
    "test": "turbo test",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.6.3",
    "@effect/tsgo": "0.46.1",
    "@oxlint/plugins": "1.85.0",
    "@shekohex/oxc-effect": "0.2.1",
    "oxfmt": "^0.70.0",
    "oxlint": "1.85.0",
    "oxlint-plugin-effect": "0.12.1",
    "oxlint-tsgolint": "7.0.2003",
    "turbo": "^2.11.4",
    "typescript": "catalog:",
    "ultracite": "^7.12.0"
  },
  "packageManager": "bun@1.4.2",
  "patchedDependencies": {
    "@astryxdesign/cli@0.6.3": "patches/@astryxdesign%2Fcli@0.6.3.patch",
    "@astryxdesign/core@0.6.3": "patches/@astryxdesign%2Fcore@0.6.3.patch",
    "permix@4.3.0": "patches/permix@4.3.0.patch"
  }
}
