{
  "$schema": "https://v2-10-12.turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": ["VITE_*"],
  "globalPassThroughEnv": ["OTEL_*"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        ".output/**",
        ".tsbuild/**"
      ]
    },
    "@effect-bun-starter/api#dev": {
      "cache": false,
      "persistent": true
    },
    "@effect-bun-starter/web#dev": {
      "cache": false,
      "persistent": true
    },
    "//#format": {},
    "//#format:fix": {
      "cache": false
    },
    "//#lint": {},
    "//#lint:fix": {
      "cache": false
    },
    "test": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": ["*.tsbuildinfo", ".tsbuild/**"]
    },
    "@effect-bun-starter/auth#typecheck": {
      "dependsOn": ["^build", "build"],
      "outputs": ["*.tsbuildinfo", ".tsbuild/**"]
    },
    "@effect-bun-starter/database#typecheck": {
      "dependsOn": ["^build", "build"],
      "outputs": ["*.tsbuildinfo", ".tsbuild/**"]
    },
    "@effect-bun-starter/domain#typecheck": {
      "dependsOn": ["^build", "build"],
      "outputs": ["*.tsbuildinfo", ".tsbuild/**"]
    },
    "@effect-bun-starter/email#typecheck": {
      "dependsOn": ["^build", "build"],
      "outputs": ["*.tsbuildinfo", ".tsbuild/**"]
    }
  }
}
